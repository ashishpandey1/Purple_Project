# Supabase Configuration
# Get these from your Supabase Dashboard > Settings > API
# OR set VITE_USE_MOCK=true for local testing without Supabase

VITE_USE_MOCK=true
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OAuth Redirect URL (REQUIRED for Google/GitHub login)
# Set this to your deployed URL (e.g., https://your-app.onrender.com)
# For local dev: http://localhost:5173
VITE_SITE_URL=https://your-app.onrender.com

# For admin operations (migrations, seeding) - keep secret!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key